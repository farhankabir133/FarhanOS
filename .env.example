# ========================================
# FarhanOS Backend Environment Variables
# Production runtime: Railway
# ========================================

# --- Required for AI features ---
# Groq API key for LLM inference (Llama 3.3 70B)
# Get your key from https://console.groq.com
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY_HERE

# --- Required for contact form email ---
# Resend API key for transactional email delivery
# Get your key from https://resend.com
RESEND_API_KEY=re_YOUR_RESEND_API_KEY_HERE

# --- Required for CORS ---
# Comma-separated list of allowed origins for CORS
# Production should be: https://farhankabir.me,https://www.farhankabir.me
CORS_ORIGINS=https://farhankabir.me,https://www.farhankabir.me

# --- Node environment ---
# Set to "production" when deploying to Railway
NODE_ENV=production

# --- Server configuration ---
# Port for the Express development server (Railway sets this automatically)
PORT=3001

# --- Optional configuration ---
# Postgres connection string (e.g. Supabase) for durable lead/chat persistence.
# When unset, the API runs stateless and simply skips persistence.
# Apply schema: psql "$DATABASE_URL" -f src/backend/db/schema.sql
DATABASE_URL=

# GitHub username for repositories API (default: farhankabir133)
GITHUB_USERNAME=farhankabir133

# Optional GitHub personal access token to raise API rate limits.
# Never use the Groq key here. Create a read-only token (no scopes needed
# for public repo data) at https://github.com/settings/tokens
GITHUB_TOKEN=

# Application base URL
APP_URL=https://api.farhankabir.me

# Frontend Environment Variables (for Vite build)
# The base URL where the frontend is hosted
VITE_BASE=/
