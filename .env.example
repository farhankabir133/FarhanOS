# GROQ_API_KEY: Required for AI chat completions (ask-twin, brief analysis, contact analysis).
GROQ_API_KEY="your_groq_api_key"

# RESEND_API_KEY: Required for contact form email delivery.
RESEND_API_KEY="your_resend_api_key"

# GITHUB_TOKEN: Optional. Raises the GitHub API rate limit from 60 to 5000 req/hr
# for the /api/github-repos endpoint. Use a fine-grained token with public repo read access.
GITHUB_TOKEN=""

# PORT: Local dev/prod server port (default 3001).
PORT=3001

# VITE_API_URL (client-side): Optional override for the API base URL.
# Leave unset for same-origin API routing on Vercel/Express deployments.
# VITE_API_URL=""
