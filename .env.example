# ========================================
# FarhanOS Backend Environment Variables
# ========================================

# --- Required for AI features ---
# Groq API key for LLM inference (Llama 3.3 70B)
# Get your key from https://console.groq.com
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY_HERE

# --- Required for contact form email ---
# Resend API key for transactional email delivery
# Get your key from https://resend.com
RESEND_API_KEY=re_YOUR_RESEND_API_KEY_HERE

# --- Server configuration ---
# Port for the Express development server (default: 3001)
PORT=3001

# --- CORS configuration ---
# Comma-separated list of allowed origins for CORS
# Use "*" to allow all origins (less secure, suitable for public portfolios)
# Example: CORS_ORIGINS=https://farhankabir.me,https://www.farhankabir.me
CORS_ORIGINS=*

# --- Cache configuration (seconds) ---
# How long Medium stories are cached (default: 900 = 15 minutes)
CACHE_MEDIUM_STORIES=900

# How long GitHub repos are cached (default: 3600 = 1 hour)
CACHE_GITHUB_REPOS=3600

# Maximum cache entries in memory (default: 100)
MAX_CACHE_ENTRIES=100

# --- Rate limiting ---
# Maximum requests per IP per window (default: 60)
RATE_LIMIT_MAX_REQUESTS=60

# Rate limit window in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# --- Application URL ---
# The base URL of the deployed application
APP_URL=https://farhankabir.me

# --- Supabase configuration ---
# Supabase project reference (only needed for API URL resolution)
VITE_SUPABASE_PROJECT_REF=urhwapbyxtjaulslmfao

# --- Build configuration ---
# Base path for static assets (default: /)
VITE_BASE=/

# --- Node environment ---
# Set to "production" when deploying the Express server
NODE_ENV=production